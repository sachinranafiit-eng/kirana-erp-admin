# Server
PORT=4000
NODE_ENV=development
HOST=127.0.0.1

# Database: use pglite for zero-setup local development, postgres in production
DB_DRIVER=pglite
DB_PATH=../../data/kirana-pglite

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kirana_erp
DB_USER=postgres
DB_PASSWORD=change_me

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_CUSTOMER_SECRET=change_this_to_a_third_long_random_string
SETUP_KEY=change_this_to_a_one_time_setup_key

# Initial super admin (used only by `npm run seed:admin`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_strong_unique_password
SEED_ADMIN_NAME=Store Owner
SEED_ADMIN_EMAIL=owner@example.com

# Online store — customer (not staff) JWT (JWT_CUSTOMER_SECRET is canonical)
CUSTOMER_JWT_EXPIRES_IN=30d

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Requires a WhatsApp Business Account + a phone number registered with Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0

# SMS — MSG91 (common India provider; needs a DLT-registered sender ID/template
# per TRAI regulations for commercial SMS in India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
